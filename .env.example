EXPO_PUBLIC_API_URL=https://dummy-api-topaz.vercel.app

# Isolates API state (orders, cash, holdings) for this tenant.
# Leave empty to fall back to the device's install id.
EXPO_PUBLIC_CANDIDATE_ID=

# Intentional API defects for QA: off | easy | medium | hard. Defaults to off.
EXPO_PUBLIC_BUGS_TIER=off
